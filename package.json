{
  "name": "lang",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "backend": "npm run build:backend && electron . --headless",
    "server": "npm run build:backend && node dist-electron/backend/src/standalone.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix frontend run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-packager . Lang --overwrite --ignore=^/frontend/src --ignore=^/frontend/node_modules --ignore=^/langData --ignore=^/tests --ignore=^/ipynb"
  },
  "dependencies": {
    "@huggingface/hub": "^2.17.6",
    "better-sqlite3": "^12.6.0",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "pinyin-pro": "^3.29.4",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "electron": "^39.2.7",
    "electron-packager": "^17.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
